# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API). Never commit .env.local — it's gitignored.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, for the AI plan-generation and tutor-memory route handlers
# (docs/architecture/api.md §2). Never expose with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Wired in W0 per the product plan (docs/designs/mtdo-web-v1-plan.md §3),
# before any real user exists.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
