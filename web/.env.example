# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API). Never commit .env.local — it's gitignored.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, for the AI plan-generation and tutor-memory route handlers
# (docs/architecture/api.md §2). Never expose with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Wired in W0 per the product plan (docs/designs/mtdo-web-v1-plan.md §3),
# before any real user exists.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ---------------------------------------------------------------------------
# Google Calendar (Phase 6 — docs/architecture/api.md §3e). ALL OF THESE ARE
# GENUINELY ABSENT TODAY: no Google Cloud project has been created for mtdo
# yet. That is a supported state, not a broken one — GET /api/calendar/status
# reports `configured: false` and names whichever of these is missing, the
# connect/sync routes return a clean 503, and Settings → Calendar says so in
# plain language. Scheduling a task onto a date and time (the schedule_block()
# RPC, migrations/0019) works completely independently of all of this.
#
# To turn it on: create OAuth 2.0 Web application credentials in the Google
# Cloud console, enable the Google Calendar API, and register the redirect URI
# below verbatim (Google matches it byte-for-byte).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Falls back to <request origin>/api/calendar/callback, which is fine
# locally but will NOT match a preview deployment's generated hostname — set it
# explicitly for anything real.
GOOGLE_OAUTH_REDIRECT_URI=

# Server-only, 32 bytes base64. Encrypts calendar_connections.refresh_token_encrypted
# at rest (AES-256-GCM, web/lib/calendar/crypto.ts). The database never sees
# this key — that is the point, see decisions.md's 2026-09-11 entry. Generate:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# A present-but-wrong-length value is reported as "not configured" rather than
# accepted and then failed on mid-OAuth.
CALENDAR_TOKEN_ENCRYPTION_KEY=

# Server-only. The FIRST use of a service-role key in this app (web/lib/supabase/
# service.ts): calendar_connections is revoked from anon/authenticated entirely,
# so only a service-role client can write it. Never prefix with NEXT_PUBLIC_,
# never import that client from anything that renders in a browser.
SUPABASE_SERVICE_ROLE_KEY=
